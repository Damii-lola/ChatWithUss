# Copy to .env for local dev. On Render, set these in the service's Environment tab.

# Public URL of this backend (must match application_url in shopify.app.toml)
APP_URL=https://app.chatwithuss.com
PORT=3000

# Dev Dashboard → your app → Settings
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Encrypts Shopify tokens at rest.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later forces every shop to silently re-authenticate on next admin visit.
TOKEN_ENCRYPTION_KEY=

# Cloudflare Workers AI (AI answers + embeddings, used from Phase 5)
# Account ID: dash.cloudflare.com → any page → right sidebar "Account ID"
# Token: My Profile → API Tokens → Create Token → "Workers AI" template (Read + Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model overrides (defaults: @cf/meta/llama-3.3-70b-instruct-fp8-fast, @cf/baai/bge-m3)
# CF_AI_CHAT_MODEL=
# CF_AI_EMBED_MODEL=

LOG_LEVEL=info
